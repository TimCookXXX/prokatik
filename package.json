{
  "name": "inrenta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose --profile dev up -d db minio minio-init",
    "dev:realtime": "tsx --env-file=.env realtime/server.ts",
    "dev:down": "docker compose --profile dev down",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:icons": "tsx scripts/build-icons.ts",
    "check-theme": "tsx scripts/check-theme.ts",
    "check-storage": "tsx --env-file=.env scripts/check-storage.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed:real": "tsx --env-file=.env scripts/seed-real.ts",
    "seed:photos": "tsx --env-file=.env scripts/seed-photos.ts",
    "geo:import": "tsx --env-file=.env scripts/geo-import.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.36.0",
    "file-type": "^22.0.1",
    "lucide-react": "^0.460.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.0",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.0",
    "ulid": "^3.0.2",
    "vaul": "^1.1.2",
    "ws": "^8.21.3",
    "zod": "^3.23.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
