# cp .env.example .env — так, как есть, годится для дева.
# После каждой строки: что нужно в проде и без чего можно жить на локали.

DOMAIN=localhost                      # прод: inrenta.ru
LETSENCRYPT_EMAIL=                    # только прод: почта для Let's Encrypt
NEXTAUTH_URL=http://localhost:3000    # прод: https://inrenta.ru

# Порт процесса доставки в реальном времени. Серверная переменная: клиент её
# не видит и строит адрес сокета из location.
REALTIME_PORT=3100

# Таймзона контейнера приложения: в ней форматируются все даты интерфейса.
TZ=Europe/Moscow

# Аварийное отключение ВСЕХ лимитов: чата, входа, регистрации, писем. Только на
# время ручных проверок. В проде оставлять нельзя — перебор пароля и рассылка
# с сайта окажутся ничем не ограничены. Применяется при перезапуске контейнера.
RATE_LIMIT_DISABLED=
NEXTAUTH_SECRET=dev-secret-not-for-production-0000000000   # прод: openssl rand -base64 32
AUTH_TRUST_HOST=                      # только прод: true, иначе Auth.js режет /api/auth/* за Caddy

DB_PASSWORD=devpassword                                      # прод: длинный, без спецсимволов — уезжает в URL
DATABASE_URL=postgres://app:devpassword@localhost:5432/app   # прод: подставляет docker-compose (хост db), из .env не читается

# NODE_ENV не задавать: next выставляет сам; с development в файле упадёт pnpm build

# --- Вход через сервисы. На деве нужны, только если проверяешь именно его.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=                 # callback на деве: http://localhost:3000/api/auth/callback/yandex — именно http
VK_CLIENT_ID=
VK_CLIENT_SECRET=                     # VK не принимает localhost: для дева нужен https-туннель

# --- Почта. Все пять или ни одной. Пусто на деве = письмо печатается в консоль dev-сервера.
SMTP_HOST=                            # smtp.yandex.ru
SMTP_PORT=                            # 465
SMTP_USER=                            # official@inrenta.ru
SMTP_PASSWORD=                        # пароль приложения из id.yandex.ru, не пароль от аккаунта
SMTP_FROM=                            # обязан совпадать с SMTP_USER
BLOCKED_EMAIL_DOMAINS=                # дополняет встроенный стоп-лист (src/lib/auth/email.ts)

# --- Загрузка фото. Все пять или ни одной. Пусто на деве = /api/upload отвечает 503.
STORAGE_ENDPOINT=                     # https://s3.twcstorage.ru
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE=                  # это ENDPOINT/BUCKET, в панели не выдаётся; нужен на этапе сборки и контейнеру caddy (img-src в CSP) — заполнять до docker compose build

# --- Бэкапы. Все четыре или ни одной. Только прод.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

INDEXNOW_KEY=                         # только прод: openssl rand -hex 16
YANDEX_METRIKA_ID=                    # только прод; пусто = метрика выключена

# --- Бот заявок без аккаунта. Все четыре или ни одной. Пусто = бота нет, вебхук отвечает 404.
# У токена один вебхук: на деве — свой бот, иначе pnpm tg:webhook уведёт апдейты прода.
TELEGRAM_BOT_TOKEN=                   # от @BotFather
TELEGRAM_BOT_USERNAME=                # inrenta_bot, без @
TELEGRAM_WEBHOOK_SECRET=              # openssl rand -hex 32; тот же уходит в pnpm tg:webhook set
TELEGRAM_ADMIN_CHAT_ID=               # id админской группы, отрицательный
BOOKING_FLOW=                         # auth (по умолчанию) | telegram — «Забронировать» ведёт в бота; telegram требует TELEGRAM_*
