{
	email {$LETSENCRYPT_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip zstd

	# Сокет и его health — отдельным обработчиком. Именно два правила, а не
	# `/ws*`: последний матчил бы и /wsomething. handle терминальный и стоит в
	# порядке директив Caddy раньше reverse_proxy, поэтому голый прокси ниже
	# остаётся обработчиком всего прочего — переносить его в handle не нужно,
	# иначе @static и общие заголовки уедут в другую ветку.
	handle /ws {
		reverse_proxy realtime:3100
	}
	handle /ws/* {
		reverse_proxy realtime:3100
	}
	# Цель внешнего монитора. В /api/health приложения realtime не подмешан
	# намеренно: туда смотрит uptimerobot, и падение вспомогательного сервиса
	# начало бы поднимать алерт «сайт лёг» и валить healthcheck самого app.
	handle /realtime-health {
		rewrite * /health
		reverse_proxy realtime:3100
	}

	reverse_proxy app:3000

	@static {
		path /_next/static/*
		path /og/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Иконки живут отдельно от @static и БЕЗ immutable, потому что заменяются:
	# они собираются из theme/brand/*.svg через `pnpm build:icons`.
	#
	# Решает здесь худший путь, а не средний. /icons/* манифест адресует голым
	# путём, а /favicon.ico браузеры дёргают из корня сами, мимо хешированной
	# ссылки в <head>; годовой immutable запер бы старую иконку в чужих кешах и
	# в уже установленном PWA, где чинить её нечем. /icon.svg и /apple-icon.png
	# запрашиваются только по хешированному адресу, для них immutable был бы
	# безопасен — они здесь ради одного правила на все иконки, а не потому, что
	# без хеша. Сутки: перевыкладка расходится за день при мизерном трафике.
	@icons {
		path /favicon.ico
		path /icon.svg
		path /apple-icon.png
		path /icons/*
	}
	header @icons Cache-Control "public, max-age=86400"

	# CSP — второй контур вокруг пользовательского контента. Инлайн-скрипт он не
	# остановит: 'unsafe-inline' обязателен, пока Next вставляет RSC-данные
	# инлайном, а nonce требует генерации в middleware (отложено, см.
	# docs/BACKLOG.md). Зато режет всё типовое продолжение такой инъекции —
	# подгрузку чужого скрипта, <base>, <object>, форму сбора паролей и вынос
	# данных фетчем на чужой хост.
	#
	# Внешние источники взяты из кода, а не на глаз:
	#   Метрика с Вебвизором — адреса из справки Метрики
	#     (yandex.ru/support/metrica/ru/code/install-counter-csp): tag.js,
	#     noscript-пиксель, отправка данных (https и wss), служебные iframe и
	#     blob-воркеры (frame-src, child-src). Из источников взято подмножество:
	#     mc.yandex.ru и mc.yandex.com, mc.webvisor.com/.org, yastatic.net;
	#     региональные mc.yandex.<kz|by|uz|…> не перечислены намеренно.
	#     Метрика поднимается только в production с заданным
	#     YANDEX_METRIKA_ID, но заголовок общий.
	#   frame-ancestors — полный список хостов интерфейса Метрики из той же
	#     справки: без него не открываются записи Вебвизора и карта кликов.
	#     Встраивать сайт в iframe не может больше никто, включая сам сайт
	#     ('self' не нужен). Заголовка X-Frame-Options нет намеренно:
	#     frame-ancestors его заменяет, а X-Frame-Options умеет только DENY и
	#     SAMEORIGIN — оба запретили бы показ в интерфейсе Метрики.
	#   wss://{$DOMAIN} — сокет realtime, это handle /ws выше.
	#   {$STORAGE_PUBLIC_BASE} — плитка «своё фото» в выборе обложки
	#     (CoverPicker) рисуется прямым <img> с домена хранилища. Всё остальное
	#     — фото объявлений, аватарки, сама обложка — идёт через next/image, то
	#     есть со своего домена. Переменная приходит из docker-compose; незаданной
	#     она на проде не бывает (без хранилища не работает и загрузка), а если
	#     всё же пуста — политика становится строже: остаётся невалидный источник
	#     `/`, который браузер отбрасывает.
	#     Записей две намеренно: путь без завершающего слэша CSP сверяет
	#     точно, а не префиксом, поэтому один только `.../bucket` разрешил бы
	#     ровно этот адрес и ни одной картинки внутри. Вариант со слэшем даёт
	#     префикс; вариант без — страхует значение, уже пришедшее со слэшем.
	#   worker-src 'self' blob: https://mc.yandex.ru — 'self' для воркера
	#     подсказок адресов (src/components/search/geo-worker.ts: Turbopack
	#     собирает его чанком со своего домена, /_next/static/chunks/
	#     turbopack-worker-*.js), blob: и mc.yandex.ru — для воркера Вебвизора.
	#     При заданном worker-src браузер не смотрит в child-src для воркеров,
	#     поэтому адреса Метрики нужны и здесь.
	# Одной строкой намеренно: перенос внутри значения заголовка недопустим.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.com https://mc.webvisor.org {$STORAGE_PUBLIC_BASE} {$STORAGE_PUBLIC_BASE}/; connect-src 'self' wss://{$DOMAIN} https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.com https://mc.webvisor.org wss://mc.yandex.ru wss://mc.yandex.com wss://mc.webvisor.com wss://mc.webvisor.org; frame-src blob: https://mc.yandex.ru https://mc.yandex.com https://mc.webvisor.com https://mc.webvisor.org; child-src blob: https://mc.yandex.ru; worker-src 'self' blob: https://mc.yandex.ru; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors metrika.yandex.ru analytics.yandex.by analytics.yandex.com analytics.yandex.com.tr analytics.yandex.kz analytics.yandex.ru metr.yandex.by metr.yandex.com metr.yandex.com.tr metr.yandex.kz metr.yandex.ru metrica.ya.ru metrica.yandex metrica.yandex.by metrica.yandex.com metrica.yandex.com.tr metrica.yandex.kz metrica.yandex.ru metrika.ya.ru metrika.yandex metrika.yandex.by metrika.yandex.com metrika.yandex.com.tr metrika.yandex.kz metrika.yandex.uz; upgrade-insecure-requests"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "interest-cohort=()"
		-Server
	}
}
